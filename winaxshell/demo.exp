#!/usr/bin/expect

set timeout -1
spawn -noecho ./bin/winaxshell ;

proc exec_command {text} {
    expect -re ".*\\$ "
    
    send -- "$text\r"
    sleep 1.5
}

exec_command "ls -l"
exec_command "echo 'Hello World'"
exec_command "pwd"
exec_command "ps f | nl | nl | nl | nl"
exec_command "exit"

expect -re "Bye! Thanks for using WinAxShell!"
