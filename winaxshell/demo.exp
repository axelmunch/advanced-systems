#!/usr/bin/expect

set timeout -1
spawn ./bin/winaxshell ;

set send_human {.4 .4 .2 .5 100}

proc exec_command {text} {
    expect -re ".*\\$ "
    
    send -h "$text\r"
}

exec_command "clear"

exec_command "ls"

exec_command "echo 'Hello World'"

exec_command "pwd"

exec_command "ps f | nl | nl | nl | nl"

exec_command "exit"
expect -re "Bye! Thanks for using WinAxShell!"

expect eof
